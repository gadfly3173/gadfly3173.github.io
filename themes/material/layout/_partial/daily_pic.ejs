<!-- Daily pic -->
<div class="mdl-card <% if(theme.card_elevation) { %><%= 'mdl-shadow--' + theme.card_elevation + 'dp' %><% } %> daily-pic mdl-cell mdl-cell--8-col index-top-block">

    <!-- Pic & Slogan -->
    <div id="daily-pic-container" class="mdl-card__media mdl-color-text--grey-50">
        <script>
          $(window).load(function() {
            const container = document.getElementById('daily-pic-container');
                        const dailyPicLink = document.getElementById('daily-pic-link');
                        const fallbackImage = <%- JSON.stringify(url_for('/img/daily_pic.jpg')) %>;
                        const dailyPicApi = <%- JSON.stringify(theme.img.daily_pic) %>;

                        container.style.backgroundImage = 'url(' + fallbackImage + ')';

                        fetch(dailyPicApi)
                            .then(function(response) {
                                if (!response.ok) {
                                    throw new Error('Failed to fetch daily picture');
                                }

                                return response.json();
                            })
                            .then(function(data) {
                                if (data && data.url) {
                                    container.style.backgroundImage = 'url(' + data.url + ')';
                                }

                                if (dailyPicLink && data && data.copyright_link) {
                                    dailyPicLink.href = data.copyright_link;
                                }
                            })
                            .catch(function(error) {
                                console.warn('Failed to load daily picture from API:', error);
                            });
          });
        </script>
        <p class="index-top-block-slogan">
          <a id="daily-pic-link" href="<%= theme.url.daily_pic %>">
          <% if(theme.uiux.slogan) { %>
              <% if(Array.isArray(theme.uiux.slogan)) { %>
                  <%- theme.uiux.slogan.join('<br>') %>
              <% } else { %>
                  <%- theme.uiux.slogan %>
              <% } %>
          <% } %>
          </a>
        </p>
    </div>

    <!-- Avatar & Name -->
    <div class="mdl-card__supporting-text meta mdl-color-text--grey-600">
        <!-- Author Avatar -->
        <div id="author-avatar">
            <img src="<%= url_for(theme.img.avatar) %>" width="32px" height="32px" alt="avatar">
        </div>
        <div>
            <strong><%= config.author %></strong>
        </div>
    </div>
</div>
